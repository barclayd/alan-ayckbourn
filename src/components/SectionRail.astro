---
import { isCurrent, siblingsOf } from '@/lib/siblings';

/**
 * The section's pages as a right-hand column, from `lg` up.
 *
 * The archive's own prose still says "use the links in the right-hand column",
 * and on the original site that column vanished below 900px. Putting it back on
 * the right — against the convention that nav goes left — makes those sentences
 * true again, and it gives the empty half of a wide screen the job it used to
 * have. Below `lg` the same list is the scrolling bar in SectionNav.
 */
type Props = { id: string };

const { id } = Astro.props;
const { root, pages } = await siblingsOf(id);
---

{
  pages.length > 0 && (
    /* Not indexed: the same list of sibling titles repeats on every page of a
       section, and each of those titles is already its own search result. */
    <nav
      aria-label={`${root?.data.title ?? 'Section'} pages`}
      class="hidden lg:block"
      data-pagefind-ignore
    >
      {/* The negative margin buys the scroll box room for the tick that crosses
          the rule: `overflow-y` clips the other axis too. */}
      <div
        class="sticky top-20 -ml-3 max-h-[calc(100svh-9rem)] overflow-y-auto pl-3 [scrollbar-width:thin]"
      >
        {root && (
          <a
            href={`/${root.id}`}
            class="block font-ui text-[0.65rem] uppercase tracking-[0.22em] text-accent transition-opacity hover:opacity-70"
          >
            {root.data.title}
          </a>
        )}

        <ul class="mt-5 border-rule border-l">
          {pages.map((page) => (
            <li>
              {/* Current page marked by a short accent rule pushed through the
                  column's own hairline — a bookmark tab in a page edge, and the
                  same short-rule idiom that sits above the h2s. */}
              <a
                href={`/${page.id}`}
                aria-current={isCurrent(id, page.id) ? 'page' : undefined}
                class="relative block py-2 pl-4 font-ui text-[0.78rem] leading-snug text-muted transition-colors before:absolute before:top-[0.95rem] before:-left-[0.4rem] before:hidden before:h-px before:w-[1.1rem] before:bg-accent hover:text-body aria-[current]:text-body aria-[current]:before:block"
              >
                {page.data.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>
  )
}
