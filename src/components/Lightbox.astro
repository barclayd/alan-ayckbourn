---
/**
 * Opens an image at its own size. 422 of the archive's 1,184 images are wider
 * than the reading measure and arrive downscaled — production photographs, cast
 * lists, programme pages — and those are exactly the ones worth a closer look.
 * So are the Instagram plates, which are 1400px shown at four hundred.
 *
 * Takes any image inside `.prose-archive`, and any image marked `data-zoomable`
 * elsewhere. Wrapping a set of them in `data-zoom-group` puts the arrow keys
 * between them, so a nine-picture carousel is read without closing the dialog
 * nine times.
 *
 * ponytail: <dialog> is the whole thing. Escape to close, focus trapped, the
 * backdrop and the return of focus all native. No library, no focus manager.
 */
---

{/*
  Sized to the viewport rather than to the picture: Tailwind's reset zeroes the
  `margin: auto` a modal dialog is centred by, so a dialog that fits its content
  lands in the top-left corner. Filling the screen and centring inside it is one
  rule instead of two, and it gives the click-to-close surface somewhere to be.
*/}
<dialog
  id="lightbox"
  aria-label="Enlarged image"
  class="fixed inset-0 m-0 h-dvh max-h-none w-dvw max-w-none bg-transparent p-0 backdrop:bg-scrim/85 backdrop:backdrop-blur-sm"
>
  <form method="dialog" class="grid h-full place-items-center p-4 sm:p-10">
    {/*
      Everything off the picture is the close button — `method="dialog"` closes
      it without JS. Out of the tab order deliberately: Escape and the button in
      the corner are the keyboard routes out, and a focus ring drawn around the
      whole screen is not a focus ring.
    */}
    <button
      type="submit"
      tabindex="-1"
      aria-hidden="true"
      class="absolute inset-0 cursor-zoom-out"></button>

    {/* Clicks fall through to the surface below, so the picture closes it too —
        all but the credit line, which is there to be read and copied. */}
    <figure
      class="pointer-events-none relative grid max-h-full min-h-0 place-items-center gap-4"
    >
      <img
        alt=""
        class="max-h-[calc(100dvh-9rem)] max-w-full rounded-sm shadow-2xl shadow-black/60"
      />
      <figcaption
        class="pointer-events-auto max-w-prose text-center font-ui text-xs text-chrome-muted empty:hidden"
      >
      </figcaption>

      {/* "3 / 9" is the caption a reader sees; a slash is not a word, and
          nothing at all was said when the arrow keys moved. The dialog's own
          label says where we started and that the arrows work — it is read on
          open, which is the only moment the offer is any use — and this says
          where each press has got to. */}
      <p class="sr-only" id="lightbox-said" aria-live="polite"></p>
    </figure>

    {/* The way out, said in the corner where a reader looks for it. `autofocus`
        so the dialog opens with focus on this rather than on the backdrop. */}
    <button
      type="submit"
      autofocus
      aria-label="Close"
      class="absolute top-3 right-3 grid h-11 w-11 place-items-center rounded-full bg-white/10 font-ui text-2xl text-chrome-ink leading-none transition-colors hover:bg-accent hover:text-white sm:top-6 sm:right-6"
    >
      &times;
    </button>
  </form>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#lightbox');
  const image = dialog?.querySelector('img');
  const caption = dialog?.querySelector('figcaption');
  const said = dialog?.querySelector('#lightbox-said');

  if (dialog && image && caption) {
    /*
     * Only the images the measure actually shrinks are offered — a 175px poster
     * has nothing more to show, and a zoom cursor over one is a broken promise.
     * Measured after load, because an unloaded image reports naturalWidth 0.
     */
    const offer = (img: HTMLImageElement) => {
      if (img.naturalWidth <= img.clientWidth) return;
      img.dataset.zoom = '';
      img.style.cursor = 'zoom-in';
      /* The zoom cursor is an offer only a mouse can see. These images come out
         of markdown, so there is no markup to wrap them in a button at build
         time — the role and the tab stop are put on the image itself instead,
         and the keydown below turns Enter and Space into the click the mouse
         already had. Alt text stays the accessible name, with the offer added
         to it, because "production photograph, 1974" is what the reader wants
         to hear first and "enlarge" is what they want to hear next. */
      img.tabIndex = 0;
      img.setAttribute('role', 'button');
      img.setAttribute(
        'aria-label',
        img.alt ? `${img.alt} — enlarge` : 'Enlarge image',
      );
    };

    const candidates = document.querySelectorAll<HTMLImageElement>(
      '.prose-archive img, img[data-zoomable]',
    );
    for (const img of candidates) {
      if (img.complete) offer(img);
      else img.addEventListener('load', () => offer(img), { once: true });
    }

    /** The pictures the arrow keys move between, and where in them we are. */
    let group: HTMLImageElement[] = [];
    let at = 0;

    const show = (index: number) => {
      const img = group[index];
      if (!img) return;
      at = index;
      /* `data-full` where the page deliberately shows a downscaled copy — the
         Instagram plates are set at four hundred pixels and shipped at four
         hundred, so `currentSrc` there is a thumbnail. Enlarging a thumbnail is
         the one thing this dialog exists not to do. */
      image.src = img.dataset.full || img.currentSrc || img.src;
      image.alt = img.alt;
      /* The archive writes its credits as an italic paragraph under the image
         ("© Tony Bartholomew"), which is the caption it never marked up. A
         grouped picture has its caption on the page behind the dialog, so all
         it needs saying is which of them this is. */
      const next = img.closest('p')?.nextElementSibling;
      const credit =
        next?.matches('p:has(em)') && !next.querySelector('img')
          ? (next.textContent?.trim() ?? '')
          : '';
      caption.textContent =
        group.length > 1 ? `${index + 1} / ${group.length}` : credit;

      if (group.length < 2) {
        dialog.setAttribute('aria-label', img.alt || 'Enlarged image');
        return;
      }
      const where = `Picture ${index + 1} of ${group.length}`;
      dialog.setAttribute(
        'aria-label',
        `${where}, enlarged. Left and right arrow keys move between pictures.`,
      );
      if (said) said.textContent = where;
    };

    document.addEventListener('click', (event) => {
      const img = (event.target as HTMLElement).closest<HTMLImageElement>(
        'img[data-zoom]',
      );
      if (!img) return;

      const owner = img.closest('[data-zoom-group]');
      group = owner
        ? [...owner.querySelectorAll<HTMLImageElement>('img[data-zoom]')]
        : [img];
      show(group.indexOf(img));
      dialog.showModal();
    });

    /* Space scrolls and Enter does nothing on an image, so both are turned into
       the click above rather than a second copy of it. */
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' && event.key !== ' ') return;
      const img = (event.target as HTMLElement).closest<HTMLImageElement>(
        'img[data-zoom]',
      );
      if (!img) return;
      event.preventDefault();
      img.click();
    });

    /* Wraps, so the last picture's right arrow returns to the first rather
       than doing nothing. The dialog has focus, so this only ever fires while
       it is open. */
    dialog.addEventListener('keydown', (event) => {
      const step = { ArrowLeft: -1, ArrowRight: 1 }[event.key];
      if (!step || group.length < 2) return;
      event.preventDefault();
      show((at + step + group.length) % group.length);
    });
  }
</script>
