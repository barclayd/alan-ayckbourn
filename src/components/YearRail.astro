---
/**
 * The sticky year rail, over any page that lists a few hundred dated things on
 * one screenful of scroll.
 *
 * It expects the page to head each year's section with `id="y{year}"` and to
 * leave enough `scroll-mt` under the sticky header for the heading to clear it.
 *
 * Where a year is a page rather than a section — Pictures, whose captions run to
 * two thousand words apiece — pass `base`, and the same rail becomes the
 * navigation between those pages instead of anchors down one.
 */
type Props = {
  years: { year: number | string; count: number }[];
  /** What the page is counting, for the total at the end of the rail. */
  label: string;
  /** Set when each year is its own page: links go to `${base}/${year}`. */
  base?: string;
  /** The year being read, when the rail is paging rather than scrolling. */
  current?: number | string;
};

const { years, label, base, current } = Astro.props;
const total = years.reduce((sum, { count }) => sum + count, 0);
---

{/*
  A rail rather than a filter: the years are the only division that means
  anything here, and with several hundred entries the whole span stays
  reachable — and the current year is marked as you scroll past it.
*/}
<nav
  id="year-rail"
  aria-label="Jump to year"
  class="sticky top-14 z-30 border-rule border-b bg-surface/95 py-3 backdrop-blur-sm"
>
  <div class="shell flex items-center gap-4">
    <ul
      class="flex min-w-0 flex-1 items-center gap-1 overflow-x-auto [scrollbar-width:thin] max-sm:[mask-image:linear-gradient(to_right,black_calc(100%-2.5rem),transparent)]"
    >
      {
        years.map(({ year, count }) => (
          <li class="shrink-0">
            <a
              href={base ? `${base}/${year}` : `#y${year}`}
              aria-current={base ? String(year === current) : undefined}
              class="block rounded-full px-3 py-1.5 font-ui text-[0.7rem] uppercase tracking-[0.12em] text-muted tabular-nums transition-colors hover:bg-surface-raised hover:text-body aria-[current=true]:bg-body aria-[current=true]:text-surface"
            >
              {year}
              <span class="ml-1.5 opacity-70">{count}</span>
            </a>
          </li>
        ))
      }
    </ul>
    {/* The total is in the hero already; on a phone it only crowds the years
        it sits next to, and the rail needs every pixel to scroll. */}
    <p
      class="hidden shrink-0 font-ui text-xs uppercase tracking-[0.16em] text-muted tabular-nums sm:block"
    >
      {total} {label}
    </p>
  </div>
</nav>

<script>
  /*
   * Marks the year you are reading in the rail. A scroll listener rather than an
   * `IntersectionObserver`: the year being read is "the last heading above the
   * line", which is a question about position, and an observer only reports
   * crossings. A long year runs for several screens with no crossing in it, and
   * a lazily-loaded photograph can move a heading past the line without any
   * scroll at all — both leave an observer holding an answer that has stopped
   * being true. One rAF-throttled read of the same geometry is shorter and
   * always right.
   */
  const rail = document.getElementById('year-rail');
  const headings = document.querySelectorAll<HTMLElement>('h2[id^="y"]');
  /**
   * The line just under the sticky header and the sticky rail, in pixels. A
   * shade below the headings' own `scroll-mt-32`, so a year jumped to from the
   * rail counts as reached rather than as still to come.
   */
  const LINE = 132;

  if (rail && headings.length > 0) {
    const mark = (id: string) => {
      for (const link of rail.querySelectorAll('a')) {
        link.setAttribute(
          'aria-current',
          String(link.hash === `#${id}`) as 'true' | 'false',
        );
      }
    };

    const update = () => {
      const passed = [...headings]
        .filter((heading) => heading.getBoundingClientRect().top < LINE)
        .at(-1);
      mark(passed?.id ?? '');
    };

    /* One read per frame at most, however fast the wheel spins. */
    let queued = false;
    addEventListener(
      'scroll',
      () => {
        if (queued) {
          return;
        }
        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          update();
        });
      },
      { passive: true },
    );
    update();
  }
</script>
