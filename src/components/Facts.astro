---
/**
 * The play data sheet: premiere dates, venues, rights holders. The scraper
 * lifts these out of the prose into frontmatter so they can be presented as
 * data rather than as another paragraph.
 */
type Props = {
  facts: Record<string, string>;
  /** Long prose values ("Short Synopsis") read better outside the grid. */
  omit?: string[];
};

const { facts, omit = [] } = Astro.props;

const entries = Object.entries(facts).filter(([key]) => !omit.includes(key));

const escapeHtml = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

/**
 * Fact values carry markdown links to rights holders and publishers, which are
 * the useful part. ponytail: a regex, not a markdown pass — the values are
 * generated by our own scraper at build time and are single-line by construction.
 */
const linkify = (value: string) =>
  escapeHtml(value).replace(
    /\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)/g,
    '<a href="$2" rel="external">$1</a>',
  );
---

<dl class="grid gap-x-8 gap-y-5 font-ui sm:grid-cols-2">
  {
    entries.map(([key, value]) => (
      <div class="border-rule border-t pt-3">
        <dt
          class="text-[0.68rem] uppercase leading-normal tracking-[0.16em] text-muted"
        >
          {key}
        </dt>
        <dd
          class="mt-1.5 text-[0.95rem] leading-snug [&_a]:text-accent [&_a]:underline [&_a]:underline-offset-2"
          set:html={linkify(value)}
        />
      </div>
    ))
  }
</dl>
