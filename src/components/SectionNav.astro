---
import { isCurrent, siblingsOf } from '@/lib/siblings';

/**
 * The bar of sibling pages that runs under the header on phones and tablets.
 * On a desktop the same list is a right-hand column instead — see SectionRail —
 * because the archive's own prose sends readers there, and one list said twice
 * a centimetre apart is one list too many.
 */
type Props = { id: string };

const { id } = Astro.props;
const { root, pages } = await siblingsOf(id);
---

{
  pages.length > 0 && (
    /* Not indexed: it is the same list of sibling titles on all fourteen pages
       of a section, and each of those pages is its own search result. */
    <nav
      aria-label={`${root?.data.title ?? 'Section'} pages`}
      class="sticky top-14 z-30 border-rule border-b bg-surface/95 backdrop-blur-sm lg:hidden"
      data-pagefind-ignore
    >
      <div class="shell flex items-center gap-4">
        {root && (
          <a
            href={`/${root.id}`}
            aria-current={id === root.id ? 'page' : undefined}
            class="shrink-0 border-transparent border-b-2 py-3 font-display text-sm uppercase leading-none tracking-wide aria-[current]:border-accent"
          >
            {root.data.title}
          </a>
        )}

        {/* One scrolling row: fourteen sections wrap to four rows on a phone,
            and this bar is sticky. */}
        <ul class="flex min-w-0 flex-1 items-center gap-4 overflow-x-auto [scrollbar-width:thin]">
          {pages.map((page) => (
            <li class="shrink-0">
              <a
                href={`/${page.id}`}
                aria-current={isCurrent(id, page.id) ? 'page' : undefined}
                class="block whitespace-nowrap border-transparent border-b-2 py-3 font-ui text-[0.72rem] uppercase tracking-[0.14em] text-muted transition-colors hover:text-body aria-[current]:border-accent aria-[current]:text-body"
              >
                {page.data.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>
  )
}
