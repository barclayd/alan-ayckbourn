---
import { Image } from 'astro:assets';
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Facts from '@/components/Facts.astro';
import Lightbox from '@/components/Lightbox.astro';
import SectionBar from '@/components/SectionBar.astro';
import SectionNav from '@/components/SectionNav.astro';
import SectionRail from '@/components/SectionRail.astro';
import Base from '@/layouts/Base.astro';
import {
  anchorOf,
  branchOf,
  labelOf,
  printsOwnIndex,
  RAIL_MAX,
} from '@/lib/section';
import { abs, breadcrumb } from '@/lib/seo';

/**
 * Every page of the archive except the handful with a page of their own. One
 * template rather than a play template plus a reading template: the two differ
 * only in whether a poster and a data sheet sit above the prose.
 */
export async function getStaticPaths() {
  const all = await getCollection('archive');

  /* `/plays` is our own index and `/search` belongs to Pagefind. `whats-on` was
     an empty `<iframe>` wrapper on the original site; the listings it framed now
     have their own page. The archive's own front page keeps its content at
     `/about` — `/` is ours now. */
  const owned = new Set(['plays', 'search', 'whats-on']);
  const routeOf = (id: string) => (id === 'welcome' ? 'about' : id);

  const titles = new Map(all.map((entry) => [entry.id, entry.data.title]));
  const childrenOf = new Map<string, CollectionEntry<'archive'>[]>();
  for (const entry of all) {
    const parent = entry.id.slice(0, entry.id.lastIndexOf('/'));
    if (!parent) {
      continue;
    }
    childrenOf.set(parent, [...(childrenOf.get(parent) ?? []), entry]);
  }

  const kidsOf = (id: string) =>
    (childrenOf.get(id) ?? [])
      .filter((child) => !owned.has(child.id))
      .sort((a, b) => a.data.order - b.data.order);

  return all
    .filter((entry) => !owned.has(entry.id))
    .map((entry) => ({
      params: { slug: routeOf(entry.id) },
      props: {
        entry,
        children: kidsOf(entry.id),
        /* A section merged into this page keeps its own children as links —
           Articles is one stop on the scroll and nine pieces underneath it, and
           the rail only carries the stops. Built here for the same reason the
           trail is: only getStaticPaths holds the whole collection. */
        under: Object.fromEntries(
          kidsOf(entry.id).map((child) => [
            child.id,
            kidsOf(child.id).map((kid) => ({
              id: kid.id,
              label: labelOf(kid, child.data.title),
            })),
          ]),
        ),
        /* Ancestors, nearest last. Built here because only getStaticPaths holds
           the whole collection; the page itself sees one entry. */
        trail: entry.id
          .split('/')
          .slice(0, -1)
          .map((_, i, parts) => parts.slice(0, i + 1).join('/'))
          .filter((id) => titles.has(id))
          .map((id) => ({ href: `/${routeOf(id)}`, title: titles.get(id) })),
      },
    }));
}

type Props = {
  entry: CollectionEntry<'archive'>;
  children: CollectionEntry<'archive'>[];
  under: Record<string, { id: string; label: string }[]>;
  trail: { href: string; title?: string }[];
};

const { entry, children, under, trail } = Astro.props;
const { year, poster, facts } = entry.data;
const { Content } = await render(entry);

/* The archive's own front page is titled "Home", which it no longer is: `/` is
   ours, this is the page the footer links to as "About this archive", and an h1
   reading "Home" on `/about` is a page that has forgotten where it lives. */
const title = entry.id === 'welcome' ? 'About this Archive' : entry.data.title;

const isPlay = /^plays\/[^/]+$/.test(entry.id);
/** The archive writes the one-line pitch as a fact; it reads as a standfirst. */
const synopsis = facts?.['Short Synopsis'];
const playNumber = facts?.['Play Number'];

/*
 * Where the section list appears — as a disclosure on a phone, as a right-hand
 * column on a desktop.
 *
 * On every page of a section, the head included. A play landing used to print
 * its fourteen pages at the foot of the article instead, which is the one place
 * a reader looking for the way on has already decided there isn't one; now the
 * same list stands beside the page from the top of the screen and does not move
 * when they scroll.
 *
 * Asked here as well as inside the components because the desktop grid reserves
 * a column for the rail, and a reserved column with nothing in it would narrow
 * the prose for nothing.
 */
const { root, pages: siblings } = await branchOf(entry.id);
const showNav = siblings.length > 0;

/* A play landing is often nothing but its data sheet once the facts are lifted
   into frontmatter, and an empty prose wrapper still prints its own line-height
   as a gap between the sheet and the section list. */
const hasBody = Boolean(entry.body?.trim());

/* `play-poster` is the name the clicked card on the index hands over, so the
   artwork travels and grows into place instead of one image fading out and
   another fading in. Set here rather than as an attribute comment — Astro reads
   anything inside the tag as a prop. */
const morph = 'view-transition-name: play-poster';

const description =
  synopsis?.replace(/[*[\]]|\(https?:\/\/[^)]*\)/g, '').slice(0, 200) ??
  `${title} — from the archive of Sir Alan Ayckbourn.`;

/*
 * The one search facet worth having across 2,458 pages: which part of the
 * archive a page belongs to. The archive's own section titles are too long for
 * a pill ("Copyright, Privacy & Alan Ayckbourn's Official Website"), and the
 * eight small sections are more useful pooled than listed separately.
 */
const SECTIONS: Record<string, string> = {
  plays: 'Plays',
  career: 'Career',
  life: 'Life',
  encyclopaedia: 'Encyclopaedia',
  publications: 'Publications',
  research: 'Research',
};
const section = SECTIONS[entry.id.split('/')[0]] ?? 'The Archive';

/** The trail as one line, so a result can say where it sits without the DOM. */
const where = [section, ...trail.slice(1).map((step) => step.title)].join(
  ' › ',
);

/* A child titled after its parent says the parent's name again in a list sitting
   directly under the parent's own h1 — see `labelOf`. */
const labels = new Map(
  children.map((child) => [child.id, labelOf(child, entry.data.title)]),
);

/* An A–Z is a rail of letters, not twenty-six full-width cards each carrying one
   character of information — see `printsOwnIndex`, which is also what the
   right-hand column asks before offering to carry the same list. */
const isRail =
  children.length > 6 &&
  children.every((child) => (labels.get(child.id)?.length ?? 0) <= 5);

/* Above the prose, not below it: Chronology puts 26,000 characters of essay
   between its heading and its 72 years, and a catalogue's contents are what the
   page is for. "Contents" rather than "In this section", which is the name the
   list of the section's other pages already goes by a centimetre above it. */
const showContents = printsOwnIndex([...labels.values()]);

/*
 * The section as one scroll.
 *
 * On the head of a branch — a play, or `life`, or `career` — the pages the rail
 * lists are built into the page itself rather than linked out of it, so a reader
 * who came for the history keeps going into the synopsis without deciding to.
 * The rail becomes a scroll-spy over what is already here.
 *
 * Rail level only. What hangs below a stop stays a page of its own and is linked
 * at the foot of its section: Absurd Person Singular is sixteen stops, and one
 * of them is nine articles that are nobody's idea of a single scroll.
 *
 * Every one of these pages also stays where it was. Nothing 404s, no redirect
 * table, and Pagefind goes on returning the sub-page rather than collapsing
 * 1,900 results into 155 — which is why the prose here is `data-pagefind-ignore`
 * and the sub-page keeps the index entry.
 */
const sections =
  root?.id === entry.id && !showContents
    ? await Promise.all(
        children.map(async (child) => {
          const kids = under[child.id] ?? [];
          return {
            anchor: anchorOf(child.id),
            label: labels.get(child.id) ?? child.data.title,
            /* A catalogue lists itself — see `printsOwnIndex`, which draws the
               same line for the rail. Anything shorter is worth naming here. */
            under: kids.length > RAIL_MAX ? [] : kids,
            Content: (await render(child)).Content,
          };
        }),
      )
    : [];

/*
 * The trail as data, and — on a play landing — the play itself.
 *
 * `Play` rather than `CreativeWork`: a play is a script that exists apart from
 * any performance of it, which is exactly the distinction this archive keeps
 * (the landing page is the work; its production history is a page of its own).
 * No `image`: the artwork these pages carry is a 175px poster scan, below the
 * size any consumer of this will accept, and an upscaled one is worse than
 * none.
 */
const nodes: Record<string, unknown>[] = [
  breadcrumb(Astro.site, [...trail, { href: Astro.url.pathname, title }]),
];

if (isPlay) {
  nodes.push({
    '@type': 'Play',
    '@id': `${abs(Astro.site, Astro.url.pathname)}#play`,
    name: entry.data.title,
    url: abs(Astro.site, Astro.url.pathname),
    author: { '@id': abs(Astro.site, '/#alan') },
    inLanguage: 'en-GB',
    ...(synopsis && { description }),
    ...(year && { datePublished: String(year) }),
  });
}
---

<Base
  title={title}
  description={description}
  section={section}
  where={where}
  pageType={entry.id === 'welcome' ? 'AboutPage' : 'WebPage'}
  jsonLd={nodes}
>
  {
    isPlay ? (
      <header class="bg-chrome text-chrome-ink">
        <div
          class="shell grid gap-8 pt-16 pb-14 sm:grid-cols-[minmax(0,15rem)_1fr] sm:gap-12"
        >
          {poster && (
            /*
              The mat, as on the card the reader just clicked. No poster the
              original site published is wider than 175px, so bare artwork beside
              a title four times its height is a stamp adrift in a column — and
              upscaling a 175px scan to fill that column is worse. The plate is
              what takes the height of the title; the artwork keeps its own size
              inside it and lands where it left the grid.
            */
            <div
              class="grid w-fit animate-[rise-in_.7s_var(--ease-stage)_both] place-items-center rounded-sm bg-chrome-raised p-6"
            >
              <Image
                src={poster}
                alt={`Poster artwork for ${title}`}
                widths={[poster.width]}
                sizes={`${poster.width}px`}
                style={morph}
                data-pagefind-meta="image[src]"
                class="max-w-full rounded-[1px] shadow-2xl shadow-black/50"
              />
            </div>
          )}

          <div class:list={[!poster && 'sm:col-span-2']}>
            <p
              class="animate-[rise-in_.6s_var(--ease-stage)_both] font-ui text-[0.7rem] uppercase tracking-[0.25em] text-chrome-muted"
              data-pagefind-meta={year && `year:${year}`}
            >
              {playNumber ? `Play ${playNumber}` : 'The Archive'}
              {year && <span class="tabular-nums"> &middot; {year}</span>}
            </p>
            <h1
              class="mt-4 animate-[rise-in_.7s_var(--ease-stage)_.06s_both] font-display text-[clamp(2.5rem,8vw,5.5rem)] uppercase leading-[0.9]"
            >
              {title}
            </h1>
            {synopsis && (
              <p
                class="mt-6 max-w-[54ch] animate-[rise-in_.7s_var(--ease-stage)_.12s_both] text-chrome-muted"
                data-pagefind-meta="synopsis"
                set:html={synopsis.replace(/\*([^*]+)\*/g, '<em>$1</em>')}
              />
            )}
          </div>
        </div>
      </header>
    ) : (
      <header class="border-rule border-b pt-12 pb-10">
        <div class="shell">
          {trail.length > 0 && (
            <nav aria-label="Breadcrumb">
              <ol
                class="flex flex-wrap items-center gap-x-2 font-ui text-[0.7rem] uppercase tracking-[0.18em] text-muted"
              >
                {trail.map((step) => (
                  <li class="after:ml-2 after:text-rule after:content-['/'] last:after:content-none">
                    <a href={step.href} class="hover:text-accent">
                      {step.title}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          )}
          <h1
            class="mt-4 max-w-[24ch] font-display text-[clamp(2.1rem,5.5vw,3.75rem)] uppercase leading-[0.95] text-balance"
          >
            {title}
          </h1>
        </div>
      </header>
    )
  }

  {
    /* The merged page tracks a scroll, so its phone-sized nav is the bar that
       tracks it too; every other page keeps the disclosure. */
    showNav &&
      (sections.length > 0 ? (
        <SectionBar id={entry.id} />
      ) : (
        <SectionNav id={entry.id} />
      ))
  }

  {/* Two columns from `lg`: the reading measure keeps its own width on the left
      and the section list takes the right edge, so a wide screen holds a page of
      prose and the way out of it instead of half a screen of nothing. */}
  <div
    class:list={[
      'shell py-14',
      /* No `items-start`: the rail sticks inside its own grid item, so that item
         has to run the height of the prose beside it. */
      showNav && 'lg:grid lg:grid-cols-[minmax(0,1fr)_14rem] lg:gap-14',
    ]}
  >
    <div class="min-w-0">
      {
        showContents && (
          /* Not indexed: every title in here is a page with its own entry, so
             indexing the list makes a section index match all of its children. */
          <nav aria-labelledby="contents" class="mb-14" data-pagefind-ignore>
            <h2
              id="contents"
              class="font-ui text-[0.7rem] uppercase tracking-[0.2em] text-accent"
            >
              Contents
            </h2>
            {/* Rows under hairlines rather than padded plates: a plate's text sits
                its own padding inside the column, so a grid of them ran 20px right
                of every other thing on the page. The rule carries the division and
                the text starts where the heading above it starts — which is also
                how the data sheet at the top of the page is set. */}
            <ul
              class:list={[
                'mt-6',
                isRail
                  ? 'flex flex-wrap gap-2'
                  : 'grid gap-x-8 sm:grid-cols-2 lg:grid-cols-3',
              ]}
            >
              {children.map((child) => (
                <li data-reveal>
                  <a
                    href={`/${child.id}`}
                    class:list={[
                      'group flex transition-colors',
                      /* No `h-full` on the rail: it is not in a grid row to fill,
                         and paired with `h-14` the two heights race in the sheet
                         and the letter tile collapses to its line box. */
                      isRail
                        ? 'h-14 min-w-14 items-center justify-center rounded-sm border border-rule bg-surface px-4 hover:bg-surface-raised'
                        : 'h-full items-baseline gap-3 border-rule border-t pt-3.5 pb-5 hover:border-accent',
                    ]}
                  >
                    <span class="font-display text-xl uppercase leading-none transition-colors group-hover:text-accent">
                      {labels.get(child.id)}
                    </span>
                    {child.data.year && (
                      <span
                        class="ml-auto font-ui text-xs text-muted tabular-nums"
                      >
                        {child.data.year}
                      </span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }

      {
        /* The data sheet before the prose: dates and venues are what most people
           came for, and the archive's own pages open with them too. */
        isPlay && facts && (
          <section aria-labelledby="data-sheet" class="mb-14" data-reveal>
            <h2
              id="data-sheet"
              class="mb-6 font-ui text-[0.7rem] uppercase tracking-[0.2em] text-accent"
            >
              Production facts
            </h2>
            <Facts facts={facts} omit={['Short Synopsis', 'Play Number']} />
          </section>
        )
      }

      {
        hasBody && (
          <div
            class:list={['prose-archive', isPlay && 'prose-epigraph']}
            data-reveal
          >
            <Content />
          </div>
        )
      }

      {
        sections.map((section, i) => (
          <section id={section.anchor} class="section-stop" data-stop>
            {/* The stop announces itself the way the play's own head does, in the
                same oxblood and the same face — so the scroll reads as a sequence
                of title cards rather than one unbroken column of grey. */}
            <div class="section-band">
              <p
                class="font-ui text-[0.62rem] uppercase tracking-[0.28em] text-chrome-muted tabular-nums"
              >
                {String(i + 1).padStart(2, '0')} / {String(sections.length).padStart(2, '0')}
              </p>
              <h2
                class="mt-2 font-display text-[clamp(1.75rem,6vw,2.75rem)] uppercase leading-[0.95]"
              >
                {section.label}
              </h2>
            </div>

            {/* Ignored by the index, not by the reader: this same prose is still
                its own page, and that is the page a search should land on. */}
            <div class="prose-archive mt-9" data-pagefind-ignore>
              <section.Content />
            </div>

            {section.under.length > 0 && (
              <nav
                aria-label={`Pages in ${section.label}`}
                class="mt-9"
                data-pagefind-ignore
              >
                <ul class="border-rule border-t">
                  {section.under.map((kid) => (
                    <li>
                      <a
                        href={`/${kid.id}`}
                        class="group flex items-baseline gap-4 border-rule border-b py-3.5 transition-colors hover:border-accent"
                      >
                        <span class="font-ui text-[0.85rem] leading-snug transition-colors group-hover:text-accent">
                          {kid.label}
                        </span>
                        <span
                          aria-hidden="true"
                          class="ml-auto text-muted transition-transform duration-300 ease-stage group-hover:translate-x-1"
                        >
                          &rarr;
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            )}
          </section>
        ))
      }
    </div>

    {showNav && <SectionRail id={entry.id} />}
  </div>

  <Lightbox />
</Base>

<style>
  /* Clear of both sticky bars, so an anchor lands under the chrome rather than
     behind it. The phone carries the section bar as well as the header. */
  .section-stop {
    scroll-margin-top: 6.5rem;
  }

  @media (width >= 64rem) {
    .section-stop {
      scroll-margin-top: 5rem;
    }
  }

  /*
   * Edge to edge on a phone, where the shell's own padding is the only thing
   * between the band and the screen. From `lg` it squares up with the column
   * instead: the rail is sitting beside it, and a band running under the rail
   * would be a band running under the thing that points at it.
   */
  .section-band {
    margin-top: 4.5rem;
    margin-inline: calc(var(--spacing) * -4);
    padding: 2.5rem calc(var(--spacing) * 4);
    background: var(--color-chrome);
    color: var(--color-chrome-ink);
  }

  @media (width >= 40rem) {
    .section-band {
      margin-inline: calc(var(--spacing) * -6);
      padding-inline: calc(var(--spacing) * 6);
    }
  }

  @media (width >= 64rem) {
    .section-band {
      margin-inline: 0;
      padding-inline: 2rem;
    }
  }
</style>
