---
import { getCollection } from 'astro:content';
import PlayCard from '@/components/PlayCard.astro';
import Base from '@/layouts/Base.astro';
import { itemList } from '@/lib/seo';

/* Landing pages only — `plays/woman-in-mind`, not `plays/woman-in-mind/history`. */
const plays = await getCollection('archive', ({ id }) =>
  /^plays\/[^/]+$/.test(id),
);

/** Files "The Norman Conquests" under N, as a library would. */
const sortKey = (title: string) => title.replace(/^(the|a|an)\s+/i, '');

/* Chronological is the default order: it is the shape of a working life. */
plays.sort(
  (a, b) =>
    (a.data.year ?? Number.POSITIVE_INFINITY) -
      (b.data.year ?? Number.POSITIVE_INFINITY) ||
    sortKey(a.data.title).localeCompare(sortKey(b.data.title)),
);

const decadeOf = (year?: number) =>
  year === undefined ? undefined : Math.floor(year / 10) * 10;

const decades = [
  ...new Set(plays.map((p) => decadeOf(p.data.year)).filter((d) => d)),
].sort((a, b) => (a ?? 0) - (b ?? 0));
---

<Base
  title="The Plays"
  description={`All ${plays.length} of Alan Ayckbourn's works for the stage, with premieres, casts, synopses and production histories.`}
  indexed={false}
  pageType="CollectionPage"
  jsonLd={itemList(
    Astro.site,
    'The plays of Alan Ayckbourn, in order of first performance',
    plays.map((play) => ({ name: play.data.title, href: `/${play.id}` })),
  )}
>
  <header class="bg-chrome pt-20 pb-16 text-chrome-ink">
    <div class="shell">
      <p
        class="animate-[rise-in_.6s_var(--ease-stage)_both] font-ui text-[0.7rem] uppercase tracking-[0.25em] text-chrome-muted"
      >
        The Archive
      </p>
      <h1
        class="mt-4 animate-[rise-in_.7s_var(--ease-stage)_.06s_both] font-display text-[clamp(3rem,11vw,8rem)] uppercase leading-[0.88]"
      >
        The Plays
      </h1>
      <p
        class="mt-6 max-w-[52ch] animate-[rise-in_.7s_var(--ease-stage)_.12s_both] text-chrome-muted"
      >
        The ninety-two numbered plays, and alongside them the revues,
        adaptations, screenplays and children's work the archive files as part
        of the same body of writing. In the order each was written.
      </p>
    </div>
  </header>

  <div
    class="sticky top-14 z-30 border-rule border-b bg-surface/95 py-3 backdrop-blur-sm"
  >
    <div class="shell flex items-center gap-4">
      {/*
        Hidden without JS: a sort button that cannot sort is worse than no
        button. Without JS the page is still the whole oeuvre in chronological
        order, which is the order that matters.

        Gated on the `.js` class, which Base sets before first paint, rather
        than on a `hidden` attribute the script clears afterwards. The
        attribute version cost 0.32 of layout shift on this page alone: the
        toolbar arrived one frame late, grew the sticky bar by 17px and pushed
        all 137 cards down with it.

        One scrolling row rather than a wrapping block: ten chips wrap to three
        rows on a phone, and this bar is sticky — it would eat a third of the
        screen for the whole scroll. A phone cuts that row off mid-chip, so it
        fades out at the right edge: a guillotined word reads as a broken
        layout, a fading one reads as more to scroll. No fade past `sm`, where
        the whole row fits and the mask would only dim the last chip.
      */}
      <div
        id="play-controls"
        class="flex min-w-0 flex-1 items-center gap-x-5 overflow-x-auto pb-0.5 [scrollbar-width:thin] max-sm:[mask-image:linear-gradient(to_right,black_calc(100%-2.5rem),transparent)]"
      >
        <div
          class="flex shrink-0 items-center gap-1"
          role="group"
          aria-label="Sort by"
        >
          <button type="button" data-sort-by="year" aria-pressed="true">
            Chronological
          </button>
          <button type="button" data-sort-by="title" aria-pressed="false">
            A&ndash;Z
          </button>
        </div>

        <div
          class="flex shrink-0 items-center gap-1"
          role="group"
          aria-label="Filter by decade"
        >
          <button type="button" data-decade-filter="" aria-pressed="true">
            All
          </button>
          {
            decades.map((decade) => (
              <button
                type="button"
                data-decade-filter={String(decade)}
                aria-pressed="false"
              >
                {decade}s
              </button>
            ))
          }
        </div>
      </div>

      {/* Server-rendered total, so it is correct before the script runs. */}
      <p
        id="play-count"
        aria-live="polite"
        class="shrink-0 font-ui text-xs uppercase tracking-[0.16em] text-muted tabular-nums"
      >
        {plays.length} works
      </p>
    </div>
  </div>

  <section class="px-4 py-14">
    <ul
      id="play-grid"
      class="shell grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 lg:grid-cols-5"
    >
      {
        plays.map((play) => (
          <li
            data-decade={decadeOf(play.data.year)}
            data-sort-key={sortKey(play.data.title)}
            data-reveal
          >
            <PlayCard play={play} />
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style is:global>
  :root:not(.js) #play-controls {
    display: none;
  }
</style>

<style>
  /* Chips. Scoped rather than repeated across ten buttons in the markup. */
  button {
    font-family: var(--font-ui);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-muted);
    padding: 0.4rem 0.7rem;
    border-radius: 100px;
    cursor: pointer;
    transition:
      color 0.2s var(--ease-stage),
      background-color 0.2s var(--ease-stage);
  }

  button:hover {
    color: var(--color-body);
    background-color: var(--color-surface-raised);
  }

  button[aria-pressed="true"] {
    color: var(--color-surface);
    background-color: var(--color-body);
  }
</style>

<script>
  const toolbar = document.getElementById('play-controls');
  const grid = document.getElementById('play-grid');
  const count = document.getElementById('play-count');

  if (toolbar && grid && count) {
    /* Sorting moves the real nodes, so tab order and screen-reader order stay
       the same as the visual order. CSS `order` would have desynced them. */
    const chronological = [...grid.children] as HTMLElement[];
    const alphabetical = [...chronological].sort((a, b) =>
      (a.dataset.sortKey ?? '').localeCompare(b.dataset.sortKey ?? ''),
    );

    let decade = '';

    const press = (pressed: Element, attr: string) => {
      for (const b of toolbar.querySelectorAll(`[${attr}]`)) {
        b.setAttribute('aria-pressed', String(b === pressed));
      }
    };

    const filter = () => {
      let shown = 0;
      for (const card of chronological) {
        card.hidden = decade !== '' && card.dataset.decade !== decade;
        if (!card.hidden) shown += 1;
      }
      count.textContent = `${shown} ${shown === 1 ? 'work' : 'works'}`;
    };

    toolbar.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest('button');
      if (!button) return;

      if (button.dataset.sortBy) {
        press(button, 'data-sort-by');
        grid.replaceChildren(
          ...(button.dataset.sortBy === 'title' ? alphabetical : chronological),
        );
      } else if (button.dataset.decadeFilter !== undefined) {
        press(button, 'data-decade-filter');
        decade = button.dataset.decadeFilter;
        filter();
      }
    });
  }
</script>
