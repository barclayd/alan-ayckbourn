---
import { Image } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import YearRail from '@/components/YearRail.astro';
import bulletins from '@/data/news.json';
import Base from '@/layouts/Base.astro';

/**
 * The archive's living half: the archivist's noticeboard, then every dispatch
 * he has filed since 2019.
 *
 * All 469 on one page rather than paginated. An archive is browsed by date, and
 * a reader who wants November 2021 should not have to guess that it is on page
 * nine — the year rail takes them straight there, and the whole thing is one
 * Cmd-F away. It costs about 90KB of HTML, which is less than one photograph.
 *
 * No category filter, deliberately: 447 of the 469 posts are tagged
 * "Ayckbourn" and 329 "Archive", so the blog's own categories separate almost
 * nothing. Date is the axis that means something here, and Pagefind already
 * covers searching by subject.
 */
const posts = (await getCollection('news')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const years = [...new Set(posts.map((post) => post.data.date.getFullYear()))];
const byYear = years.map((year) => ({
  year,
  posts: posts.filter((post) => post.data.date.getFullYear() === year),
}));

/** Only two of the blog's categories describe a different kind of thing. */
const KINDS = ['Video', 'Interview'];
const kindOf = (categories: string[]) =>
  KINDS.find((kind) => categories.includes(kind));

const dayMonth = (date: Date) =>
  date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short' });
const longDate = (date: Date) =>
  date.toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });

/* Recency earns room: the newest dispatches show their standfirst and picture,
   the rest are a line each. The whole archive on one page only reads if most
   of it is a line. */
const EXPANDED = 6;

type Bulletin = {
  kind: string;
  title?: string;
  /** Slug of the play the notice is about, where it is about one. Hand-set in
      `news.json`: matching the titles would guess, and three of the archive's
      play pages are all called "The Norman Conquests". */
  play?: string;
  when?: string;
  posted?: string;
  revised?: boolean;
  detailHtml?: string;
  href?: string | null;
};

const board = await Promise.all(
  (bulletins.items as Bulletin[])
    .filter((item) => item.kind === 'item' && item.title)
    .sort((a, b) => (b.posted ?? '').localeCompare(a.posted ?? ''))
    .map(async (item) => ({
      item,
      play: item.play
        ? await getEntry('archive', `plays/${item.play}`)
        : undefined,
    })),
);
const boardUpdated = longDate(new Date(bulletins.updated));

/* The oldest five notices predate the archivist's dated format and carry only
   "2023" or, once, "Farcebook". His words, so his line. */
const noticeDate = (item: Bulletin) =>
  item.posted ? longDate(new Date(item.posted)) : item.when;
---

<Base
  title="News"
  description={`${posts.length} dispatches from Alan Ayckbourn's archive since 2019, and the current noticeboard.`}
  section="News"
  indexed={false}
>
  <header class="bg-chrome pt-20 pb-16 text-chrome-ink">
    <div class="shell">
      <p
        class="animate-[rise-in_.6s_var(--ease-stage)_both] font-ui text-[0.7rem] uppercase tracking-[0.25em] text-chrome-muted"
      >
        Archiving Ayckbourn
      </p>
      <h1
        class="mt-4 animate-[rise-in_.7s_var(--ease-stage)_.06s_both] font-display text-[clamp(3rem,11vw,8rem)] uppercase leading-[0.88]"
      >
        News
      </h1>
      <p
        class="mt-6 max-w-[48ch] animate-[rise-in_.7s_var(--ease-stage)_.12s_both] text-[1.15em] text-chrome-ink/90"
      >
        {posts.length} dispatches filed since {years.at(-1)} by Alan
        Ayckbourn&rsquo;s archivist, Simon Murgatroyd &mdash; premieres,
        rediscoveries, revivals and the odd correction.
      </p>
    </div>
  </header>

  {/*
    The noticeboard: the archivist's own front page, in his order. Short,
    dated, sometimes revised — closer to a notice pinned up by the stage door
    than to an article, so it is set as one.

    Open, not folded away. There are fifteen of these and each is a sentence or
    three whose point is the link at the end of it; a title alone tells you
    neither what happened nor where to go, so folding them hid the only part
    that was any use. It also put a full reading-size paragraph under a
    UI-sized label, which read as a caption above its own body text.
  */}
  <section
    aria-labelledby="noticeboard"
    class="border-rule border-b bg-surface-raised py-14"
  >
    <div class="shell">
      <div
        class="flex flex-wrap items-baseline gap-x-5 gap-y-1 border-rule border-b pb-4"
      >
        <h2
          id="noticeboard"
          class="font-display text-[clamp(1.9rem,4.5vw,2.75rem)] uppercase leading-none"
        >
          Noticeboard
        </h2>
        <p
          class="font-ui text-[0.68rem] uppercase tracking-[0.16em] text-muted"
        >
          Updated <time datetime={bulletins.updated}>{boardUpdated}</time>
        </p>
      </div>

      <ul>
        {
          board.map(({ item, play }) => (
            <li
              class="grid gap-x-10 gap-y-5 border-rule/60 border-b py-8 last:border-0 sm:grid-cols-[minmax(0,62ch)_auto] sm:justify-start"
              data-reveal
            >
              <div class="min-w-0">
                <p class="font-ui text-[0.68rem] uppercase tracking-[0.16em] text-muted">
                  {item.posted ? (
                    <time datetime={item.posted}>{noticeDate(item)}</time>
                  ) : (
                    noticeDate(item)
                  )}
                  {item.revised && (
                    <span class="text-accent"> &mdash; updated</span>
                  )}
                </p>

                <h3 class="mt-2 font-display text-[clamp(1.35rem,2.6vw,1.75rem)] uppercase leading-[1.05] text-balance">
                  {item.href ? (
                    <a
                      href={item.href}
                      class="transition-colors hover:text-accent"
                    >
                      {item.title}
                    </a>
                  ) : (
                    item.title
                  )}
                </h3>

                {item.detailHtml && (
                  <div
                    class="notice mt-3 max-w-[62ch] text-[0.85em] text-muted"
                    set:html={item.detailHtml}
                  />
                )}
              </div>

              {/* The play it is about, where it is about one — five of the
                  fifteen. No mat and no placeholder for the other ten: an
                  empty frame reads as a picture that failed to load, and a
                  notice about a book or an award has no poster to show. */}
              {play?.data.poster && (
                <a href={`/${play.id}`} class="group block w-32">
                  {/* Posters run from square to double-height — the Norman
                      Conquests sheet is all three plays stacked. A common
                      height with the artwork sitting on it keeps the column
                      even without cropping anybody's design. */}
                  <div class="flex h-[11rem] items-end justify-center">
                    <Image
                      src={play.data.poster}
                      alt=""
                      widths={[128, 256]}
                      sizes="8rem"
                      data-poster
                      class="max-h-full w-auto rounded-sm outline outline-rule -outline-offset-1 transition-transform duration-500 ease-stage group-hover:-translate-y-1 group-focus-visible:-translate-y-1"
                    />
                  </div>
                  <span class="mt-3 block font-ui text-[0.6rem] uppercase leading-tight tracking-[0.14em] text-muted transition-colors group-hover:text-accent">
                    {play.data.title}
                    {play.data.year && <> &middot; {play.data.year}</>}
                  </span>
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <YearRail years={byYear.map((y) => ({ year: y.year, count: y.posts.length }))} label="dispatches" />

  <div class="shell py-14">
    {
      byYear.map(({ year, posts: inYear }) => (
        <section aria-labelledby={`y${year}`} class="mb-14 last:mb-0">
          <h2
            id={`y${year}`}
            class="scroll-mt-32 border-rule border-b pb-2 font-display text-[clamp(2.5rem,7vw,4.5rem)] uppercase leading-[0.9] tabular-nums"
          >
            {year}
          </h2>

          <ol>
            {inYear.map((post, i) => {
              const expanded = year === years[0] && i < EXPANDED;
              const kind = kindOf(post.data.categories);
              return (
                <li
                  class="dispatch grid grid-cols-[3.25rem_1fr] gap-x-4 sm:grid-cols-[5rem_1fr] sm:gap-x-6"
                  data-reveal
                >
                  <time
                    datetime={post.data.date.toISOString()}
                    class="pt-5 text-right font-ui text-[0.7rem] uppercase leading-5 tracking-[0.1em] text-muted tabular-nums"
                  >
                    {dayMonth(post.data.date)}
                  </time>

                  <div
                    class:list={[
                      'dispatch-body border-rule border-l pb-5 pl-5 sm:pl-7',
                      expanded ? 'pt-5' : 'pt-5',
                    ]}
                  >
                    <a href={`/news/${post.id}`} class="group block">
                      <h3
                        class:list={[
                          'font-display uppercase leading-[1] text-balance transition-colors group-hover:text-accent',
                          expanded
                            ? 'text-[clamp(1.4rem,3.2vw,2rem)]'
                            : 'text-[1.15rem]',
                        ]}
                      >
                        {post.data.title}
                      </h3>

                      {/* Flex rather than a grid: a fixed thumbnail beside a
                          measure of text needs no columns, and half of these
                          dispatches have no picture — a grid would leave its gap
                          behind. */}
                      {expanded && (
                        <div class="mt-3 flex flex-col gap-5 sm:flex-row sm:items-start">
                          <p class="max-w-[60ch] flex-1 text-[0.95em] text-muted">
                            {post.data.excerpt}
                          </p>
                          {post.data.hero && (
                            /* 144px on screen, so 288 covers a retina phone and
                               nothing wider is worth the bytes — the blog's own
                               copies run to 1800px. */
                            <Image
                              src={post.data.hero}
                              alt=""
                              width={post.data.heroWidth}
                              height={post.data.heroHeight}
                              widths={[Math.min(post.data.heroWidth ?? 288, 288)]}
                              sizes="144px"
                              loading="lazy"
                              decoding="async"
                              class="w-36 shrink-0 rounded-sm outline outline-rule -outline-offset-1 sm:ml-auto"
                            />
                          )}
                        </div>
                      )}
                    </a>

                    {kind && (
                      <p class="mt-2 font-ui text-[0.6rem] uppercase tracking-[0.16em] text-accent">
                        {kind}
                      </p>
                    )}
                  </div>
                </li>
              );
            })}
          </ol>
        </section>
      ))
    }
  </div>
</Base>

<style>
  /*
   * A notice is one paragraph of the archivist's own HTML, so it is styled here
   * rather than given `prose-archive` — that utility opens a page at 1.2em,
   * which is what set a notice above the headline it belongs to.
   */
  .notice :global(p + p) {
    margin-top: 0.75em;
  }

  .notice :global(a) {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 3px;
    transition: color 0.25s var(--ease-stage);
  }

  .notice :global(a:hover) {
    color: var(--color-body);
  }

  /*
   * The dateline. One hairline down the page with a marker per dispatch — the
   * same vocabulary the run rule on What's On uses, because both are time drawn
   * as a line. The marker sits on the rule rather than beside it, so it has to
   * be positioned against the border it interrupts.
   */
  .dispatch-body {
    position: relative;
  }

  .dispatch-body::before {
    content: "";
    position: absolute;
    top: 1.85rem;
    left: -3px;
    height: 5px;
    width: 5px;
    border-radius: 100px;
    background-color: var(--color-rule);
    transition: background-color 0.25s var(--ease-stage);
  }

  .dispatch:hover .dispatch-body::before,
  .dispatch:focus-within .dispatch-body::before {
    background-color: var(--color-accent);
  }

  /* The rule is continuous through the year, so the ends need closing off. */
  .dispatch:first-child .dispatch-body {
    border-image: linear-gradient(to bottom, transparent 1.85rem, var(--color-rule) 1.85rem)
      1 / 0 0 0 1px;
  }

  .dispatch:last-child .dispatch-body {
    border-image: linear-gradient(to bottom, var(--color-rule) calc(100% - 1.5rem), transparent calc(100% - 1.5rem))
      1 / 0 0 0 1px;
  }
</style>
