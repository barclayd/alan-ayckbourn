---
import { Image } from 'astro:assets';
import feed from '@/data/instagram.json';
import Base from '@/layouts/Base.astro';
import { itemList } from '@/lib/seo';

/**
 * The archivist's photographs: 854 of them in 404 posts, as posted to Alan
 * Ayckbourn's official Instagram since 2022.
 *
 * The plates themselves are a year to a page — see `pictures/[year].astro` for
 * why. What is left here is the way in, and a contact sheet is the honest shape
 * for it: a strip off the top of each year, at the size a proof sheet is read
 * at, with the year set in the same face the rest of the archive keeps its
 * dates in. It says what a list of five links cannot, which is what is in there.
 */
const years = [...new Set(feed.posts.map((post) => post.date.slice(0, 4)))];

const month = (iso: string) =>
  new Date(iso).toLocaleDateString('en-GB', { month: 'long' });

/** The strip is a proof sheet, so it is read at proof-sheet size. */
const STRIP_WIDTH = 400;
const STRIP = 6;

const sheets = years.map((year) => {
  const posts = feed.posts.filter((post) => post.date.startsWith(year));
  /* Newest first, so the year begins at the end of the list. */
  const span =
    posts.length > 1
      ? `${month(posts.at(-1)?.date ?? '')} — ${month(posts[0].date)}`
      : month(posts[0].date);

  return {
    year,
    posts: posts.length,
    pictures: posts.reduce((sum, post) => sum + post.pictures.length, 0),
    span,
    /* One off the top of each post rather than six off the first: a carousel of
       nine views of one programme is not a year. */
    strip: posts.slice(0, STRIP).map((post) => post.pictures[0]),
  };
});

const pictures = feed.posts.reduce(
  (sum, post) => sum + post.pictures.length,
  0,
);
---

<Base
  title="Pictures"
  description={`${pictures} photographs from Alan Ayckbourn's official Instagram — first nights, rehearsal rooms, programmes and the archive's own shelves.`}
  section="Pictures"
  indexed={false}
  pageType="CollectionPage"
  jsonLd={itemList(
    Astro.site,
    "Photographs from Alan Ayckbourn's official Instagram, by year",
    sheets.map((sheet) => ({
      name: `Pictures ${sheet.year}`,
      href: `/pictures/${sheet.year}`,
    })),
  )}
>
  <header class="bg-chrome pt-20 pb-16 text-chrome-ink">
    <div class="shell">
      <p
        class="animate-[rise-in_.6s_var(--ease-stage)_both] font-ui text-[0.7rem] uppercase tracking-[0.25em] text-chrome-muted"
      >
        The official feed
      </p>
      <h1
        class="mt-4 animate-[rise-in_.7s_var(--ease-stage)_.06s_both] font-display text-[clamp(3rem,11vw,8rem)] uppercase leading-[0.88]"
      >
        Pictures
      </h1>
      <p
        class="mt-6 max-w-[52ch] animate-[rise-in_.7s_var(--ease-stage)_.12s_both] text-[1.15em] text-chrome-ink/90"
      >
        {pictures} photographs posted since {years.at(-1)} by Alan Ayckbourn&rsquo;s
        archivist &mdash; first nights and rehearsal rooms, posters, programmes
        and the shelves they are kept on. Every caption is his.
      </p>
      <p
        class="mt-8 animate-[rise-in_.7s_var(--ease-stage)_.18s_both] font-ui text-[0.7rem] uppercase tracking-[0.2em]"
      >
        <a
          href={`https://www.instagram.com/${feed.handle}/`}
          rel="noopener"
          class="group inline-flex items-center gap-2 text-chrome-muted transition-colors hover:text-chrome-accent"
        >
          <span class="border-current border-b pb-1">@{feed.handle}</span>
          <span
            class="transition-transform duration-300 ease-stage group-hover:translate-x-1"
            aria-hidden="true">&rarr;</span
          >
        </a>
      </p>
    </div>
  </header>

  <div class="shell py-14">
    <ol>
      {
        sheets.map((sheet) => (
          <li class="sheet" data-reveal>
            <a href={`/pictures/${sheet.year}`} class="sheet-link group/sheet">
              <div class="flex items-baseline justify-between gap-6">
                <h2 class="font-display text-[clamp(2.5rem,9vw,5.5rem)] uppercase leading-[0.9] tabular-nums transition-colors group-hover/sheet:text-accent">
                  {sheet.year}
                </h2>
                <p class="shrink-0 text-right font-ui text-[0.68rem] uppercase leading-5 tracking-[0.14em] text-muted tabular-nums">
                  {sheet.posts} posts
                  <br />
                  {sheet.pictures} photographs
                </p>
              </div>

              {/* Unlabelled on purpose: the year, the count and the span above
                  already say what this is, and six alt texts invented for
                  pictures their own author left uncaptioned would say less. */}
              <div class="sheet-strip">
                {sheet.strip.map((picture) => (
                  <Image
                    src={picture.src}
                    width={picture.width}
                    height={picture.height}
                    widths={[STRIP_WIDTH]}
                    sizes="10rem"
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                ))}
              </div>

              <p class="mt-4 flex items-center justify-between gap-4 font-ui text-[0.62rem] uppercase tracking-[0.16em] text-muted">
                <span>{sheet.span}</span>
                <span class="inline-flex items-center gap-2 transition-colors group-hover/sheet:text-accent">
                  See the year
                  <span
                    class="transition-transform duration-300 ease-stage group-hover/sheet:translate-x-1"
                    aria-hidden="true"
                  >
                    &rarr;
                  </span>
                </span>
              </p>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</Base>

<style>
  .sheet {
    border-top: 1px solid var(--color-rule);
  }

  .sheet:last-child {
    border-bottom: 1px solid var(--color-rule);
  }

  .sheet-link {
    display: block;
    padding: 1.75rem 0 2rem;
  }

  /* The proof sheet: one strip of frames, cut off at the edge of the measure
     rather than wrapped, because a proof sheet is a roll and not a grid. It
     scrolls sideways on a phone, where six frames will not fit whatever they
     are set at. */
  .sheet-strip {
    display: flex;
    gap: 0.5rem;
    margin-top: 1.5rem;
    overflow-x: auto;
    scrollbar-width: none;
    mask-image: linear-gradient(to right, black calc(100% - 3rem), transparent);
  }

  .sheet-strip::-webkit-scrollbar {
    display: none;
  }

  .sheet-strip img {
    flex: 0 0 auto;
    width: 9rem;
    height: 9rem;
    object-fit: cover;
    border-radius: 2px;
    outline: 1px solid var(--color-rule);
    outline-offset: -1px;
    /* Held back a shade until the year is pointed at, so the page reads as a
       column of years with pictures under them rather than as a wall. */
    filter: saturate(0.75) brightness(0.9);
    transition: filter 0.4s var(--ease-stage);
  }

  @media (width >= 40rem) {
    .sheet-strip {
      mask-image: none;
      overflow: hidden;
    }

    /* Equal frames, whatever shape the picture in one is: `min-width` has to be
       said out loud or a flex item refuses to shrink past its own content. */
    .sheet-strip img {
      flex: 1 1 0;
      width: 0;
      min-width: 0;
      height: 11rem;
    }
  }

  .sheet-link:hover .sheet-strip img,
  .sheet-link:focus-visible .sheet-strip img {
    filter: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .sheet-strip img {
      transition: none;
    }
  }
</style>
