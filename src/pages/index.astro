---
import Base from '@/layouts/Base.astro';
---

<Base title="Alan Ayckbourn" chrome="landing">
  <section class="mx-auto flex min-h-dvh max-w-4xl flex-col justify-center px-6">
    <p
      class="font-ui text-xs tracking-[0.25em] text-chrome-muted uppercase"
    >
      Playwright &middot; Director
    </p>
    <h1
      class="mt-4 font-display text-6xl leading-[0.9] uppercase sm:text-8xl"
    >
      Sir Alan<br />Ayckbourn
    </h1>
    <p class="mt-8 max-w-prose text-chrome-muted">
      92 plays across sixty-seven years. Scaffold in place &mdash; the archive
      lands next.
    </p>
  </section>
</Base>
