---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import listings from '@/data/whats-on.json';
import Base from '@/layouts/Base.astro';

/**
 * The call board: which Ayckbourn productions are on, and where.
 *
 * The reader's question is not "what has been announced" but "can I still get
 * there", so the page is grouped by that answer rather than by month, and each
 * open run draws its own dates as a rule with tonight marked on it.
 */
type Listing = {
  kind: string;
  title?: string;
  where?: string;
  when?: string;
  from?: string;
  to?: string;
  detail?: string;
  href?: string | null;
  play?: string | null;
  html?: string;
};

const items = (listings.items as Listing[]).filter(
  (item) => item.kind === 'item',
);

/*
 * A listing's artwork is the archive's own poster for the play it names.
 *
 * Not the venue's: every ticket page was read for an og:image first, and of the
 * fourteen listings only four returned one — two of those were house branding
 * (a portrait of Victoria Wood beside an Ayckbourn premiere), and the two that
 * were real production art belong to plays whose poster we already hold, one of
 * them the same artwork in a wider crop. Scraping bought no listing a picture it
 * could not get from here, and would have shipped two wrong ones.
 */
const posters = new Map(
  (await getCollection('archive'))
    .filter((entry) => entry.data.poster)
    .map((entry) => [`/${entry.id}`, entry.data.poster]),
);

/*
 * Status is worked out at build time, against the day the site was built.
 *
 * That is not a shortcut: these listings are a snapshot of a page the
 * archivist maintains by hand, so a production that has closed stays listed
 * until the next scrape either way. Deciding it in the browser instead would
 * make the chip fresher than the facts it describes, and would disagree with
 * the group the item was rendered into. The hero says which day the listings
 * are from, so the vintage is on the page.
 */
const today = new Date().toISOString().slice(0, 10);
const openNow = (item: Listing) =>
  (item.to ?? '9999-99-99') >= today && (item.from ?? '0000-00-00') <= today;

const now = items
  .filter((item) => (item.from || item.to) && openNow(item))
  /* Closing soonest first: that is the one with a deadline on it. */
  .sort((a, b) => (a.to ?? '9999').localeCompare(b.to ?? '9999'));
const soon = items
  .filter((item) => (item.from ?? '') > today)
  .sort((a, b) => (a.from ?? '').localeCompare(b.from ?? ''));
/* No dates at all: streaming, the YouTube channel, a standing exhibition. */
const always = items.filter((item) => !item.from && !item.to);
const closed = items.filter(
  (item) => item.to && item.to < today && !openNow(item),
);

const groups = [
  {
    id: 'now',
    label: 'On stage now',
    note: 'Running tonight',
    items: now,
  },
  {
    id: 'soon',
    label: 'Coming up',
    note: 'Announced, not yet open',
    items: soon,
  },
  {
    id: 'always',
    label: 'Any time',
    note: 'Streaming, broadcast and online',
    items: always,
  },
  /* Only if the listings have outlived the last scrape — better than a page
     that quietly drops a production the archivist still has posted. */
  {
    id: 'closed',
    label: 'Recently closed',
    note: 'Still listed on the archive',
    items: closed,
  },
].filter((group) => group.items.length > 0);

/**
 * How far through its run a production is, 0–100, or `null` where that cannot
 * be drawn: a single performance, or a run whose first night is not stated.
 */
const progress = (item: Listing) => {
  if (!item.from || !item.to || item.from === item.to) {
    return null;
  }
  const span = Date.parse(item.to) - Date.parse(item.from);
  const done = Date.parse(today) - Date.parse(item.from);
  return span > 0 ? Math.min(100, Math.max(0, (done / span) * 100)) : null;
};

const monthDay = (iso: string) =>
  new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
const longDate = (iso: string) =>
  new Date(iso).toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });

const updated = longDate(listings.updated);
const intro = (listings.items as Listing[]).find(
  (item) => item.kind === 'intro',
)?.html;

/* The hero states the one fact the page exists to carry, in words rather than
   as a statistic: how many productions a reader could see tonight. */
const spell = [
  'no',
  'one',
  'two',
  'three',
  'four',
  'five',
  'six',
  'seven',
  'eight',
  'nine',
  'ten',
  'eleven',
  'twelve',
];
const count = (n: number, one: string, many = `${one}s`) =>
  `${spell[n] ?? n} ${n === 1 ? one : many}`;
const cap = (s: string) => s[0].toUpperCase() + s.slice(1);
---

<Base
  title="What's On"
  description={`Ayckbourn productions on stage now and announced: ${items.length} listings, updated ${updated}.`}
  section="What's On"
  indexed={false}
>
  <header class="bg-chrome pt-20 pb-16 text-chrome-ink">
    <div class="shell">
      <p
        class="animate-[rise-in_.6s_var(--ease-stage)_both] font-ui text-[0.7rem] uppercase tracking-[0.25em] text-chrome-muted"
      >
        The Call Board
      </p>
      <h1
        class="mt-4 animate-[rise-in_.7s_var(--ease-stage)_.06s_both] font-display text-[clamp(3rem,11vw,8rem)] uppercase leading-[0.88]"
      >
        What&rsquo;s On
      </h1>
      <p
        class="mt-6 max-w-[46ch] animate-[rise-in_.7s_var(--ease-stage)_.12s_both] text-[1.15em] text-chrome-ink/90"
      >
        {cap(count(now.length, 'production'))} on stage tonight{
          soon.length > 0 && `, and ${count(soon.length, 'run')} to come`
        }.
      </p>
      <p
        class="mt-5 animate-[rise-in_.7s_var(--ease-stage)_.18s_both] font-ui text-[0.72rem] uppercase tracking-[0.16em] text-chrome-muted"
      >
        Listings as of <time datetime={listings.updated}>{updated}</time>
      </p>
    </div>
  </header>

  <div class="shell py-14">
    {
      intro && (
        <div
          class="prose-archive mb-16 text-muted"
          data-reveal
          set:html={intro}
        />
      )
    }

    {
      groups.map((group) => (
        <section aria-labelledby={`group-${group.id}`} class="mb-16 last:mb-0">
          <div class="flex items-baseline gap-4 border-rule border-b pb-3">
            <h2
              id={`group-${group.id}`}
              class="font-display text-[1.6rem] uppercase leading-none"
            >
              {group.label}
            </h2>
            <p class="font-ui text-[0.68rem] uppercase tracking-[0.16em] text-muted">
              {group.note}
            </p>
            <p class="ml-auto font-ui text-sm text-muted tabular-nums">
              {group.items.length}
            </p>
          </div>

          <ul>
            {group.items.map((item) => {
              const pct = progress(item);
              const poster = item.play ? posters.get(item.play) : undefined;
              return (
                <li
                  class="border-rule border-b"
                  data-reveal
                >
                  <article
                    class:list={[
                      'grid gap-x-5 gap-y-4 py-7 sm:gap-x-8',
                      poster
                        ? 'grid-cols-[4.5rem_minmax(0,1fr)] sm:grid-cols-[9rem_minmax(0,1fr)_minmax(0,15rem)]'
                        : 'sm:grid-cols-[minmax(0,1fr)_minmax(0,15rem)]',
                    ]}
                  >
                    {poster && (
                      /*
                        A second route to a page the title already links to, so
                        it is out of the tab order and unnamed rather than read
                        aloud twice. It lifts on hover because the card on the
                        plays grid does, and this is the same picture.
                      */
                      <a
                        href={item.play}
                        tabindex="-1"
                        aria-hidden="true"
                        class="group"
                      >
                        {/* The mat, at the archive's own scale: no poster the
                            original site published is wider than 176px, so the
                            plate takes the height and the artwork keeps its
                            size inside it rather than being blown up to fill a
                            column. */}
                        <div class="grid h-24 place-items-center rounded-sm bg-surface-raised p-2 transition-transform duration-500 ease-stage group-hover:-translate-y-1 group-hover:rotate-[1.5deg] sm:h-[11.5rem] sm:p-3">
                          <Image
                            src={poster}
                            alt=""
                            widths={[poster.width]}
                            sizes={`${poster.width}px`}
                            data-poster
                            class="max-h-[4.75rem] max-w-full rounded-[1px] shadow-lg shadow-black/25 sm:max-h-[9.5rem]"
                          />
                        </div>
                      </a>
                    )}

                    <div>
                      {/* Bigger than it was: with the booking moved out to the
                          dates, the title is what this column is for, and a
                          call board says the name of the show loudly. */}
                      <h3 class="font-display text-[clamp(1.5rem,3.4vw,2.5rem)] uppercase leading-[0.98] text-balance">
                        {item.play ? (
                          <a
                            href={item.play}
                            class="transition-colors hover:text-accent"
                          >
                            {item.title}
                          </a>
                        ) : (
                          item.title
                        )}
                      </h3>
                      {item.where && (
                        <p class="mt-2 text-muted">{item.where}</p>
                      )}
                      {item.detail && (
                        <p class="mt-2 font-ui text-[0.82rem] text-muted">
                          {item.detail}
                        </p>
                      )}

                      {/* The way further into the archive, which is a quieter
                          errand than booking a seat — so it is set in the muted
                          ink and the accent is left to the one action the page
                          exists to enable. */}
                      {item.play && (
                        <p class="mt-4 font-ui text-[0.7rem] uppercase tracking-[0.14em]">
                          <a
                            href={item.play}
                            class="group text-muted transition-colors hover:text-body"
                          >
                            About the play
                            <span
                              aria-hidden="true"
                              class="ml-1 inline-block transition-transform duration-300 ease-stage group-hover:translate-x-1"
                            >
                              &rarr;
                            </span>
                          </a>
                        </p>
                      )}
                    </div>

                    {/*
                      The run, drawn as the thing it is: a line from the first
                      night to the last, with tonight marked on it. Where the
                      first night is not stated the line simply fades in from
                      the left — the run started before the listing did.
                    */}
                    <div
                      class:list={[
                        'sm:pt-2',
                        /* Under the poster and the title on a phone, where
                           three columns would leave the run rule 4rem wide. */
                        poster && 'col-span-2 sm:col-span-1',
                      ]}
                    >
                      {item.when ? (
                        <>
                          <p class="font-ui text-[0.82rem] tabular-nums">
                            {item.when}
                          </p>
                          {(pct !== null || (group.id === 'now' && item.to)) && (
                            <div
                              class="run mt-3"
                              style={pct === null ? undefined : `--run: ${pct}%`}
                              data-open={group.id === 'now' ? '' : undefined}
                              data-unknown-start={
                                pct === null ? '' : undefined
                              }
                            >
                              <span class="run-track" aria-hidden="true" />
                              <p class="mt-2 flex justify-between font-ui text-[0.62rem] uppercase tracking-[0.14em] text-muted tabular-nums">
                                <span>
                                  {item.from ? monthDay(item.from) : 'Open'}
                                </span>
                                <span>
                                  {item.to ? monthDay(item.to) : ''}
                                </span>
                              </p>
                            </div>
                          )}
                        </>
                      ) : (
                        <p class="font-ui text-[0.7rem] uppercase tracking-[0.16em] text-muted">
                          No dates listed
                        </p>
                      )}

                      {/* Booking sits at the foot of the dates, not beside the
                          title: a seat is bought for a night at a venue, and
                          the reader decides on it having just read when the run
                          is. It ends the column the run rule starts. */}
                      {item.href && (
                        <p class="mt-5 font-ui text-[0.7rem] uppercase tracking-[0.14em]">
                          <a href={item.href} class="group text-accent">
                            {group.id === 'always' ? 'Watch' : 'Tickets'}
                            <span
                              aria-hidden="true"
                              class="ml-1 inline-block transition-transform duration-300 ease-stage group-hover:translate-x-1"
                            >
                              &rarr;
                            </span>
                          </a>
                        </p>
                      )}
                    </div>
                  </article>
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }

    <p class="mt-16 max-w-[60ch] font-ui text-[0.8rem] text-muted">
      Listings are maintained by Alan Ayckbourn&rsquo;s archivist and reproduced
      here from <a
        href="https://archivingayckbourn.home.blog/whats-on/"
        class="underline decoration-accent underline-offset-4 hover:text-body"
        >Archiving Ayckbourn</a
      >. Check with the venue before travelling &mdash; dates change.
    </p>
  </div>
</Base>

<style>
  /*
   * The run rule. `--run` is how far through the run tonight is, so the filled
   * portion and the marker are one number: the marker sits at the end of the
   * fill rather than being positioned separately and drifting out of step.
   */
  .run {
    --run: 0%;
  }

  .run-track {
    display: block;
    position: relative;
    height: 2px;
    background-color: var(--color-rule);
  }

  /* End caps: a run has a first night and a last, and they are points on it. */
  .run-track::before,
  .run-track::after {
    content: "";
    position: absolute;
    top: -3px;
    height: 8px;
    width: 1px;
    background-color: var(--color-rule);
  }

  .run-track::before {
    left: 0;
  }

  .run-track::after {
    right: 0;
  }

  .run[data-open] .run-track {
    background-image: linear-gradient(
      to right,
      var(--color-accent) var(--run),
      var(--color-rule) var(--run)
    );
  }

  /* Tonight. Only on an open run — on one that has not started there is
     nothing to mark, and the left cap already says where it begins. */
  .run[data-open] .run-track::before {
    left: var(--run);
    top: -4px;
    height: 10px;
    width: 2px;
    background-color: var(--color-accent);
  }

  /* An open-ended run: no stated first night, so the line arrives out of the
     left margin instead of starting at a cap. */
  .run[data-unknown-start] .run-track {
    background-image: linear-gradient(
      to right,
      transparent,
      var(--color-accent) 2.5rem
    );
  }

  .run[data-unknown-start] .run-track::before {
    content: none;
  }

  /* The fill grows in once, when the listing scrolls up. Reduced motion is
     handled globally: the transition collapses and the bar is simply there. */
  .run-track {
    transform-origin: left;
    animation: run-draw 0.9s var(--ease-stage) both;
  }

  @keyframes run-draw {
    from {
      transform: scaleX(0);
    }
  }
</style>
