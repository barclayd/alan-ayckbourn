---
import { getEntry, render } from 'astro:content';
import Facts from '@/components/Facts.astro';
import Base from '@/layouts/Base.astro';

/**
 * Kitchen sink. Every primitive the rest of the site is built from, rendered
 * against real archive text — the only honest way to judge the reading measure,
 * the pull-out boxes and the theme flip. Reviewed on desktop and phone before
 * the templates get built on top of it.
 */
const play = await getEntry('archive', 'plays/absurd-person-singular');
const page = await getEntry('archive', 'plays/absurd-person-singular/history');
/* Picked for its image column and captions — the other half of the prose styles. */
const illustrated = await getEntry('archive', 'life/influences/harold-pinter');

if (!play || !page || !illustrated) {
  throw new Error('Style guide needs its sample archive pages');
}

const { Content } = await render(page);
const { Content: Illustrated } = await render(illustrated);

const swatches = [
  { name: 'surface', className: 'bg-surface' },
  { name: 'surface-raised', className: 'bg-surface-raised' },
  { name: 'body', className: 'bg-body' },
  { name: 'muted', className: 'bg-muted' },
  { name: 'rule', className: 'bg-rule' },
  { name: 'accent', className: 'bg-accent' },
];
---

<Base title="Style" description="Design system reference.">
  <div class="bg-chrome px-4 py-16 text-chrome-ink sm:px-6">
    <div class="mx-auto max-w-6xl">
      <p class="font-ui text-xs uppercase tracking-[0.25em] text-chrome-muted">
        Reference
      </p>
      <h1 class="mt-3 font-display text-5xl uppercase leading-[0.9] sm:text-7xl">
        Design system
      </h1>
    </div>
  </div>

  <div class="mx-auto max-w-6xl space-y-20 px-4 py-16 sm:px-6">
    <section>
      <h2
        class="font-ui text-[0.7rem] uppercase tracking-[0.2em] text-muted"
      >
        Type scale
      </h2>
      <div class="mt-6 space-y-6">
        <p class="font-display text-6xl uppercase leading-[0.9]">
          Absurd Person Singular
        </p>
        <p class="font-display text-3xl uppercase leading-none">
          Behind the scenes
        </p>
        <p
          class="font-ui text-[0.7rem] uppercase tracking-[0.2em] text-muted"
        >
          World premiere &middot; 26 June 1972
        </p>
        <p class="max-w-[68ch]">
          Body copy in Newsreader at 19px on a 1.65 line height. The archive runs
          to hundreds of thousands of words, so the reading measure is capped at
          68 characters and the type is set a size larger than the web default.
          Play titles arrive from the original markup as <em>italics</em>, and
          emphasis as <strong>semibold</strong>.
        </p>
      </div>
    </section>

    <section>
      <h2
        class="font-ui text-[0.7rem] uppercase tracking-[0.2em] text-muted"
      >
        Reading surface
      </h2>
      <ul class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
        {
          swatches.map(({ name, className }) => (
            <li>
              <div
                class:list={[
                  'h-16 rounded-sm outline outline-rule -outline-offset-1',
                  className,
                ]}
              />
              <p class="mt-2 font-ui text-xs text-muted">{name}</p>
            </li>
          ))
        }
      </ul>
      <p class="mt-4 font-ui text-sm text-muted">
        Chrome tokens do not flip &mdash; the header, hero and footer stay dark in
        both themes.
      </p>
    </section>

    <section>
      <h2
        class="font-ui text-[0.7rem] uppercase tracking-[0.2em] text-muted"
      >
        Data sheet
      </h2>
      <div class="mt-6" data-reveal>
        {play.data.facts && <Facts facts={play.data.facts} omit={['Short Synopsis']} />}
      </div>
    </section>

    <section>
      <h2
        class="font-ui text-[0.7rem] uppercase tracking-[0.2em] text-muted"
      >
        Reveal on scroll
      </h2>
      <ul class="mt-6 grid gap-3 sm:grid-cols-3">
        {
          [0, 1, 2].map((i) => (
            <li
              class="border-rule border-t bg-surface-raised p-5 font-ui text-sm"
              data-reveal
              style={`--reveal-delay: ${i * 0.09}s`}
            >
              Staggered by <code>--reveal-delay</code>, collapsed to nothing
              under <code>prefers-reduced-motion</code>.
            </li>
          ))
        }
      </ul>
    </section>

    <section>
      <h2
        class="font-ui text-[0.7rem] uppercase tracking-[0.2em] text-muted"
      >
        Archive prose &mdash; {page.data.title}
      </h2>
      <article class="prose-archive mt-6">
        <Content />
      </article>
    </section>

    <section>
      <h2 class="font-ui text-[0.7rem] uppercase tracking-[0.2em] text-muted">
        Pictures &amp; captions &mdash; {illustrated.data.title}
      </h2>
      <article class="prose-archive mt-6">
        <Illustrated />
      </article>
    </section>
  </div>
</Base>
