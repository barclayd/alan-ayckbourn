---
import Base from '@/layouts/Base.astro';

/**
 * A door of one's own, for the handful of people this concept is actually being
 * shown to.
 *
 * Cloudflare Web Analytics is deliberately anonymous — no cookie, no
 * identifier, and *Path* is the only dimension that can carry anything we
 * choose. So the way to learn whether the archivist opened the link is to give
 * the archivist his own path and watch for it. `/hello/simon` appearing in Top
 * Pages is the whole signal. It says a link was opened, not who opened it;
 * anyone he forwards it to counts the same.
 *
 * Unlisted rather than secret: nothing links here, the whole site is `noindex`,
 * and the page says plainly who it was written for.
 */
const GUESTS: Record<string, { name: string; note: string }> = {
  simon: {
    name: 'Simon Murgatroyd',
    note: 'Every word here is yours — thirty years of it, and the reason there is anything to rebuild. This is only a new set of clothes for it, offered in case any of it is useful.',
  },
  alan: {
    name: 'Sir Alan Ayckbourn',
    note: 'A reader’s attempt at giving your archive the website its contents deserve. Ninety-two plays, sixty-seven years, and every page of the record Simon Murgatroyd has kept.',
  },
};

export function getStaticPaths() {
  return ['simon', 'alan'].map((who) => ({ params: { who } }));
}

const guest = GUESTS[Astro.params.who];
---

<Base title="An invitation" indexed={false}>
  {/* One screen, and nothing on it but the address and the way in — a
      programme's title page, not a landing page. */}
  <section
    class="flex min-h-[min(88svh,46rem)] flex-col justify-center bg-chrome py-24 text-chrome-ink"
  >
    <div class="shell">
      <p
        class="animate-[rise-in_.6s_var(--ease-stage)_both] font-ui text-[0.7rem] uppercase tracking-[0.25em] text-chrome-accent"
      >
        For
      </p>
      <h1
        class="mt-4 max-w-[14ch] animate-[rise-in_.7s_var(--ease-stage)_.06s_both] font-display text-[clamp(2.5rem,8vw,5.5rem)] uppercase leading-[0.9]"
      >
        {guest.name}
      </h1>
      <p
        class="mt-8 max-w-[46ch] animate-[rise-in_.7s_var(--ease-stage)_.12s_both] text-chrome-muted"
      >
        {guest.note}
      </p>
      <p class="mt-12 animate-[rise-in_.7s_var(--ease-stage)_.18s_both]">
        <a
          href="/"
          class="inline-block border-chrome-accent border-b-2 pb-1 font-ui text-sm uppercase tracking-[0.2em] transition-colors hover:text-chrome-accent"
        >
          Enter the archive
        </a>
      </p>
    </div>
  </section>
</Base>
