---
import { Font } from 'astro:assets';
import SearchPalette from '@/components/SearchPalette.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteNotice from '@/components/SiteNotice.astro';
import '@/styles/global.css';

type Props = {
  title: string;
  description?: string;
  /** Search facet and result subtitle. Pagefind reads both off `<main>`. */
  section?: string;
  where?: string;
  /**
   * Our own composed pages — the home page, the plays grid, search itself — are
   * not search results: they are made of other pages' titles and would match
   * every query. Pagefind skips any page without the body marker once some page
   * has one, so dropping it is the whole opt-out.
   */
  indexed?: boolean;
};

const {
  title,
  description = 'The work of Sir Alan Ayckbourn: 92 plays across sixty-seven years.',
  section,
  where,
  indexed = true,
} = Astro.props;

const fullTitle =
  title === 'Alan Ayckbourn' ? title : `${title} — Alan Ayckbourn`;

/*
 * Cloudflare Web Analytics: pageviews, paths, referrers and countries, with no
 * cookie, no identifier and nothing to consent to — which is the only kind of
 * measurement worth putting on someone else's archive.
 *
 * The token is a site ID from the Cloudflare dashboard, not a secret, but it is
 * per-deployment, so it comes from the environment rather than the repo. Unset
 * — every local build, every fork — and the beacon is simply not written.
 */
const beacon = import.meta.env.PUBLIC_CF_BEACON;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    {/* The original site's own icon: a black-and-white portrait of Alan, in the
        three sizes it publishes, each cut for the size it is shown at. Declared
        so no browser falls back to requesting /favicon.ico, which would 404 on
        every page. */}
    <link rel="icon" href="/favicon-16.png" type="image/png" sizes="16x16" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-64.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />

    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload />
    <Font cssVariable="--font-ui" />

    <!-- Applied before first paint so the chosen theme never flashes, and so a
         dismissed notice never appears and collapses, shoving the page down.
         `js` also gates the reveal-on-scroll styles, so nothing is hidden
         without JS. -->
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('theme');
        const dark = stored
          ? stored === 'dark'
          : matchMedia('(prefers-color-scheme: dark)').matches;
        const root = document.documentElement;
        root.classList.toggle('dark', dark);
        root.classList.toggle(
          'notice-read',
          localStorage.getItem('notice') === 'read',
        );
        root.classList.add('js');
      })();
    </script>
  </head>
  <body class="flex min-h-dvh flex-col antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:bg-accent focus:px-4 focus:py-2 focus:font-ui focus:text-accent-ink"
    >
      Skip to content
    </a>
    <SiteNotice />
    <SiteHeader />
    {/* `data-pagefind-body` scopes the index to the page's own content. Without
        it every page matched "Ayckbourn", "Murgatroyd" and every nav label,
        because the header and footer are on all 2,459 of them. */}
    <main
      id="main"
      class="flex-1"
      data-pagefind-body={indexed ? true : undefined}
      data-pagefind-filter={section && `Section:${section}`}
      data-pagefind-meta={where && `trail:${where}`}
    >
      <slot />
    </main>
    <SiteFooter />
    <SearchPalette />

    <!--
      Reveal-on-scroll for anything marked [data-reveal]. Deliberately one
      IntersectionObserver rather than CSS scroll-driven animations plus a
      fallback: same result, one code path, works on every browser we support.
      ponytail: if this ever needs scrub-linked motion, that's when view()
      timelines earn their second code path.
    -->
    <script>
      const revealed = document.querySelectorAll('[data-reveal]');

      if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
        for (const el of revealed) el.removeAttribute('data-reveal');
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            /*
             * The stagger belongs to the batch that crossed the fold together,
             * not to the element's index in its list. Set per call site as
             * `i * 0.06s`, the homepage's 137-card grid queued its last card
             * 8.16s behind its first — so a reader who scrolled faster than the
             * queue arrived at a screen of nothing and waited three seconds for
             * it. A batch is at most a couple of rows, and it cascades in a
             * third of a second however long the list it came from.
             */
            let n = 0;
            for (const { target, isIntersecting } of entries) {
              if (!isIntersecting) continue;
              (target as HTMLElement).style.setProperty(
                '--reveal-delay',
                `${Math.min(n++, 6) * 0.05}s`,
              );
              target.setAttribute('data-reveal', 'in');
              io.unobserve(target);
            }
          },
          /* Positive, so a section starts its fade just before it arrives rather
             than 12% after — the difference between fading in and being late. */
          { rootMargin: '0px 0px 15% 0px' },
        );
        for (const el of revealed) io.observe(el);
      }
    </script>

    <!--
      The poster morph. A play's artwork is linked from four places — the plays
      grid, the front page, the call board and the noticeboard — and in each of
      them the play page it opens shows the same picture. Naming it on the way
      out lets the browser carry that one image across instead of fading one out
      while an identical one fades in.

      Here rather than in PlayCard, where it started: three of the four call
      sites are not cards, and a listener copied into each of them is three
      places to forget. ponytail: one delegated listener for the whole site.
    -->
    <script>
      document.addEventListener('click', (event) => {
        const link = (event.target as HTMLElement).closest('a');
        if (!link) return;

        /*
         * The poster this link is on its way to: the one inside the link, or —
         * where the call board gives a listing a picture and a title as two
         * separate links — the one beside it in the same row pointing at the
         * same play.
         */
        const beside = [
          ...(link
            .closest('li')
            ?.querySelectorAll<HTMLAnchorElement>('a:has([data-poster])') ?? []),
        ].find((sibling) => sibling.href === link.href);

        const poster =
          link.querySelector<HTMLElement>('[data-poster]') ??
          beside?.querySelector<HTMLElement>('[data-poster]');

        /* A view-transition-name must be unique in its document, so only the
           clicked one is named — 150 named posters would each become a
           transition group and the browser would animate 149 nobody clicked. */
        if (poster) poster.style.viewTransitionName = 'play-poster';
      });

      /* Coming back restores the page from the bfcache with the name still set,
         which would strand the next transition. */
      addEventListener('pageshow', () => {
        for (const el of document.querySelectorAll<HTMLElement>(
          '[data-poster]',
        )) {
          el.style.viewTransitionName = '';
        }
      });
    </script>

    {
      beacon && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: beacon })}
        />
      )
    }
  </body>
</html>
