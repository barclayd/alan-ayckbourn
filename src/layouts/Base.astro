---
import { Font } from 'astro:assets';
import SearchPalette from '@/components/SearchPalette.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import '@/styles/global.css';

type Props = {
  title: string;
  description?: string;
  /** Dark chrome runs edge to edge on landing pages; reading pages sit on paper. */
  chrome?: 'landing' | 'reading';
  /** Search facet and result subtitle. Pagefind reads both off `<main>`. */
  section?: string;
  where?: string;
  /**
   * Our own composed pages — the home page, the plays grid, search itself — are
   * not search results: they are made of other pages' titles and would match
   * every query. Pagefind skips any page without the body marker once some page
   * has one, so dropping it is the whole opt-out.
   */
  indexed?: boolean;
};

const {
  title,
  description = 'The work of Sir Alan Ayckbourn: 92 plays across sixty-seven years.',
  chrome = 'reading',
  section,
  where,
  indexed = true,
} = Astro.props;

const fullTitle =
  title === 'Alan Ayckbourn' ? title : `${title} — Alan Ayckbourn`;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload />
    <Font cssVariable="--font-ui" />

    <!-- Applied before first paint so the chosen theme never flashes. `js` also
         gates the reveal-on-scroll styles, so nothing is hidden without JS. -->
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('theme');
        const dark = stored
          ? stored === 'dark'
          : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', dark);
        document.documentElement.classList.add('js');
      })();
    </script>
  </head>
  <body
    class:list={[
      'flex min-h-dvh flex-col antialiased',
      chrome === 'landing' && 'bg-chrome text-chrome-ink',
    ]}
  >
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:bg-accent focus:px-4 focus:py-2 focus:font-ui focus:text-white"
    >
      Skip to content
    </a>
    <SiteHeader />
    {/* `data-pagefind-body` scopes the index to the page's own content. Without
        it every page matched "Ayckbourn", "Murgatroyd" and every nav label,
        because the header and footer are on all 2,459 of them. */}
    <main
      id="main"
      class="flex-1"
      data-pagefind-body={indexed ? true : undefined}
      data-pagefind-filter={section && `Section:${section}`}
      data-pagefind-meta={where && `trail:${where}`}
    >
      <slot />
    </main>
    <SiteFooter />
    <SearchPalette />

    <!--
      Reveal-on-scroll for anything marked [data-reveal]. Deliberately one
      IntersectionObserver rather than CSS scroll-driven animations plus a
      fallback: same result, one code path, works on every browser we support.
      ponytail: if this ever needs scrub-linked motion, that's when view()
      timelines earn their second code path.
    -->
    <script>
      const revealed = document.querySelectorAll('[data-reveal]');

      if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
        for (const el of revealed) el.removeAttribute('data-reveal');
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const { target, isIntersecting } of entries) {
              if (!isIntersecting) continue;
              target.setAttribute('data-reveal', 'in');
              io.unobserve(target);
            }
          },
          { rootMargin: '0px 0px -12% 0px' },
        );
        for (const el of revealed) io.observe(el);
      }
    </script>
  </body>
</html>
